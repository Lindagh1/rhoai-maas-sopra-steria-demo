{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "atelier-ventes",
    "namespace": "ventes-demo-repetition",
    "labels": {
      "opendatahub.io/dashboard": "true"
    },
    "annotations": {
      "openshift.io/display-name": "Fichiers atelier ventes"
    }
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "resources": {
      "requests": {
        "storage": "5Gi"
      }
    }
  }
}
